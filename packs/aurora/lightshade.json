    {"name": "volume", "fragment": "shaders/volume.fsh", "inputs": {"Depth": "$depth", "LsNoise": "$noise"}, "output": "volume", "scale": 0.5, "format": "RGBA16_FLOAT"},
    {"name": "atmosphere", "fragment": "shaders/atmosphere.fsh", "inputs": {"Scene": "$scene", "Depth": "$depth", "Volume": "volume", "Clouds": "clouds", "LsNoise": "$noise", "OpaqueDepth": "$opaqueDepth"}, "output": "atmosphere", "scale": 1.0, "format": "RGBA16_FLOAT"},
