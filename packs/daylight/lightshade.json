{
  "version": 1,
  "name": "Lightshade Daylight",
  "tag": "Vanilla+",
  "description": "Clean vanilla+: warm sun with cool sky-blue shade, soft shadows, clear turquoise water, refined clouds and cosy torchlight. Light on the GPU.",
  "budgetMiB": 384,
  "ownsSky": true,
  "terrain": {"vertex": "shaders/terrain.vsh", "fragment": "shaders/terrain.fsh"},
  "shadow": {"vertex": "shaders/shadow.vsh"},
  "options": {
    "LIGHT_DAY": {"label": "Daylight", "category": "Lighting", "default": 1.0, "values": [0.7, 0.85, 1.0, 1.15, 1.3]},
    "SKY_FILL": {"label": "Sky light in shade", "category": "Lighting", "default": 1.0, "values": [0.5, 0.75, 1.0, 1.25, 1.5]},
    "LIGHT_NIGHT": {"label": "Night light", "category": "Lighting", "default": 1.0, "values": [0.5, 0.75, 1.0, 1.5, 2.0]},
    "TORCH_BRIGHTNESS": {"label": "Torch light", "category": "Lighting", "default": 1.0, "values": [0.6, 0.8, 1.0, 1.2, 1.5]},
    "HELD_LIGHTING": {"label": "Light from held items", "category": "Lighting", "default": 1.0, "values": [0.0, 1.0]},
    "AMBIENT_OCCLUSION": {"label": "Contact shading", "category": "Lighting", "default": 1.0, "values": [0.0, 1.0, 2.0]},

    "SHADOWS": {"label": "Sun shadows", "category": "Shadows", "default": 1.0, "values": [0.0, 1.0]},
    "SHADOW_STRENGTH": {"label": "Shadow darkness", "category": "Shadows", "default": 0.75, "values": [0.0, 0.25, 0.5, 0.75, 1.0]},
    "SHADOW_SOFTNESS": {"label": "Shadow softness", "category": "Shadows", "default": 1.0, "values": [0.5, 1.0, 1.5, 2.0]},
    "SHADOW_RESOLUTION": {"label": "Shadow detail", "category": "Shadows", "default": 2048.0, "values": [1024.0, 2048.0, 3072.0]},
    "SHADOW_DISTANCE": {"label": "Shadow range", "category": "Shadows", "default": 96.0, "values": [64.0, 96.0, 128.0, 160.0]},

    "WATER_WAVES": {"label": "Waves", "category": "Water", "default": 1.0, "values": [0.0, 0.5, 1.0, 1.5, 2.0]},
    "WATER_WAVE_SPEED": {"label": "Wave speed", "category": "Water", "default": 1.0, "values": [0.5, 1.0, 1.5, 2.0]},
    "WATER_REFLECTIVITY": {"label": "Reflections", "category": "Water", "default": 1.0, "values": [0.5, 0.75, 1.0, 1.25, 1.5]},
    "WATER_REFLECTION_QUALITY": {"label": "Reflection quality", "category": "Water", "default": 1.0, "values": [0.0, 1.0, 2.0]},
    "WATER_SMOOTHNESS": {"label": "Smooth water", "category": "Water", "default": 0.5, "values": [0.0, 0.25, 0.5, 0.75, 1.0]},
    "WATER_DEPTH": {"label": "Water clarity", "category": "Water", "default": 1.0, "values": [0.5, 0.75, 1.0, 1.5]},
    "WATER_FOAM": {"label": "Shoreline foam", "category": "Water", "default": 0.5, "values": [0.0, 0.5, 1.0]},

    "SUN_TILT": {"label": "Sun path tilt", "category": "Sky", "default": 15.0, "values": [0.0, 10.0, 15.0, 20.0, 30.0]},
    "SUN_SIZE": {"label": "Sun size", "category": "Sky", "default": 1.0, "values": [0.5, 0.75, 1.0, 1.25, 1.5, 2.0, 2.5, 3.0]},
    "MOON_SIZE": {"label": "Moon size", "category": "Sky", "default": 1.0, "values": [0.5, 0.75, 1.0, 1.25, 1.5, 2.0, 2.5, 3.0]},
    "CLOUD_QUALITY": {"label": "Clouds", "category": "Sky", "default": 1.0, "values": [0.0, 1.0]},
    "CLOUD_COVER": {"label": "Cloud cover", "category": "Sky", "default": 1.0, "values": [0.0, 0.5, 1.0, 1.5]},
    "SKY_GOLDEN": {"label": "Sunset colour", "category": "Sky", "default": 0.75, "values": [0.0, 0.5, 0.75, 1.0]},
    "SKY_AURORA": {"label": "Northern lights", "category": "Sky", "default": 0.0, "values": [0.0, 0.5, 1.0]},

    "WAVING_PLANTS": {"label": "Waving grass and flowers", "category": "Nature", "default": 1.0, "values": [0.0, 0.5, 1.0, 1.5, 2.0]},
    "WAVING_LEAVES": {"label": "Waving leaves", "category": "Nature", "default": 0.5, "values": [0.0, 0.5, 1.0]},
    "FOLIAGE_GLOW": {"label": "Sunlight through leaves", "category": "Nature", "default": 0.5, "values": [0.0, 0.5, 1.0]},

    "EXPOSURE": {"label": "Brightness", "category": "Atmosphere", "default": 1.0, "values": [0.8, 0.9, 1.0, 1.1, 1.2]},
    "SATURATION": {"label": "Colour", "category": "Atmosphere", "default": 1.05, "values": [0.9, 1.0, 1.05, 1.1, 1.2]},
    "VIBRANCE": {"label": "Vibrance", "category": "Atmosphere", "default": 0.15, "values": [0.0, 0.15, 0.3, 0.45]},
    "CONTRAST": {"label": "Contrast", "category": "Atmosphere", "default": 0.12, "values": [0.0, 0.12, 0.25, 0.4]},
    "BLOOM_STRENGTH": {"label": "Glow", "category": "Atmosphere", "default": 0.35, "values": [0.0, 0.2, 0.35, 0.6, 1.0]},
    "ATMOSPHERE": {"label": "Distance haze", "category": "Atmosphere", "default": 1.0, "values": [0.0, 0.5, 1.0, 1.5, 2.0]},

    "GODRAYS": {"label": "Light shafts", "category": "Advanced", "default": 1.0, "values": [0.0, 1.0, 2.0]},
    "GODRAYS_STRENGTH": {"label": "Light shaft strength", "category": "Advanced", "default": 1.0, "values": [0.5, 1.0, 1.5, 2.0]},
    "VOLUMETRIC_LIGHT": {"label": "Volumetric light", "category": "Advanced", "default": 0.0, "values": [0.0, 1.0, 2.0]},
    "VOLUMETRIC_STRENGTH": {"label": "Volumetric strength", "category": "Advanced", "default": 1.0, "values": [0.5, 1.0, 1.5]}
  },
  "presets": [
    {"name": "Low", "values": {"SHADOWS": 0.0, "SHADOW_RESOLUTION": 1024.0, "SHADOW_DISTANCE": 64.0, "WATER_REFLECTION_QUALITY": 0.0, "GODRAYS": 0.0, "VOLUMETRIC_LIGHT": 0.0, "AMBIENT_OCCLUSION": 0.0}},
    {"name": "Medium", "values": {"SHADOWS": 1.0, "SHADOW_RESOLUTION": 1024.0, "SHADOW_DISTANCE": 64.0, "WATER_REFLECTION_QUALITY": 1.0, "GODRAYS": 1.0, "VOLUMETRIC_LIGHT": 0.0, "AMBIENT_OCCLUSION": 0.0}},
    {"name": "High", "values": {"SHADOWS": 1.0, "SHADOW_RESOLUTION": 2048.0, "SHADOW_DISTANCE": 96.0, "WATER_REFLECTION_QUALITY": 1.0, "GODRAYS": 1.0, "VOLUMETRIC_LIGHT": 0.0, "AMBIENT_OCCLUSION": 1.0}},
    {"name": "Ultra", "values": {"SHADOWS": 1.0, "SHADOW_RESOLUTION": 3072.0, "SHADOW_DISTANCE": 128.0, "WATER_REFLECTION_QUALITY": 2.0, "GODRAYS": 2.0, "VOLUMETRIC_LIGHT": 1.0, "AMBIENT_OCCLUSION": 2.0}}
  ],
  "passes": [
    {"name": "clouds", "fragment": "shaders/clouds.fsh", "inputs": {"Depth": "$depth"}, "output": "clouds", "scale": 0.5, "format": "RGBA16_FLOAT"},
    {"name": "volume", "fragment": "shaders/volume.fsh", "inputs": {"Depth": "$depth"}, "output": "volume", "scale": 0.25, "format": "RGBA16_FLOAT"},
    {"name": "atmosphere", "fragment": "shaders/atmosphere.fsh", "inputs": {"Scene": "$scene", "Depth": "$depth", "Volume": "volume", "Clouds": "clouds"}, "output": "atmosphere", "scale": 1.0, "format": "RGBA16_FLOAT"},
    {"name": "rays", "fragment": "shaders/rays.fsh", "inputs": {"Depth": "$depth"}, "output": "rays", "scale": 0.25, "format": "RGBA16_FLOAT"},
    {"name": "bloom", "fragment": "shaders/bloom.fsh", "inputs": {"Scene": "atmosphere"}, "output": "bloom", "scale": 0.5, "format": "RGBA16_FLOAT"},
    {"name": "display", "fragment": "shaders/display.fsh", "inputs": {"Scene": "atmosphere", "Bloom": "bloom", "Rays": "rays"}, "output": "$screen", "scale": 1.0}
  ]
}
